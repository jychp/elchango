{
  "description": "Report supported Claude Code lifecycle events to the local elChango app.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/api/hooks/claude-code",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/api/hooks/claude-code",
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/api/hooks/claude-code",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/api/hooks/claude-code",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/api/hooks/claude-code",
            "timeout": 2
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/api/hooks/claude-code",
            "timeout": 2
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/api/hooks/claude-code",
            "timeout": 2
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/api/hooks/claude-code",
            "timeout": 2
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/api/hooks/claude-code",
            "timeout": 2
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog|elicitation_complete|elicitation_response|agent_needs_input|agent_completed",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/api/hooks/claude-code",
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/api/hooks/claude-code",
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/api/hooks/claude-code",
            "timeout": 2
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/api/hooks/claude-code",
            "timeout": 2
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/api/hooks/claude-code",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/api/hooks/claude-code",
            "timeout": 2
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/api/hooks/claude-code",
            "timeout": 2
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/api/hooks/claude-code",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
